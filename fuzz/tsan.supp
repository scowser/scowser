# TSan suppressions for scowser
# Suppress known data races in system libraries (not our code)

# libglib gdbus thread race in Qt's QNetworkProxyFactory
# Triggered by QNetworkAccessManager::get() → systemProxyForQuery() → libglib internals
race:libglib-2.0
race:libgobject-2.0
race:libproxy
race:libpxbackend
race:g_malloc
race:g_rec_mutex_lock

# Chromium internal thread races in Qt WebEngine
# Race between Chrome_IOThread and ThreadPoolService on pthread_mutex init/trylock
# inside libQt6WebEngineCore — triggered by QWebEngineProfile construction.
race:libQt6WebEngineCore
