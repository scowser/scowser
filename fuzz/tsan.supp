# TSan suppressions for scowser
# Suppress known data races in system libraries (not our code)

# libglib gdbus thread race in Qt's QNetworkProxyFactory
# Triggered by QNetworkAccessManager::get() → systemProxyForQuery() → libglib internals
race:libglib-2.0
race:libgobject-2.0
race:libproxy
race:libpxbackend
race:g_malloc
race:g_rec_mutex_lock
