# Valgrind suppressions for scowser
# Suppress known Qt/Chromium internal allocations that are not real leaks

{
   qt_platform_init
   Memcheck:Leak
   ...
   fun:*QGuiApplication*
}

{
   qt_core_init
   Memcheck:Leak
   ...
   fun:*QCoreApplication*
}

{
   qt_thread_pool
   Memcheck:Leak
   ...
   fun:*QThreadPool*
}

{
   qt_opengl
   Memcheck:Leak
   ...
   fun:*QOpenGL*
}

{
   dl_open
   Memcheck:Leak
   ...
   fun:_dl_open
}

{
   dl_init
   Memcheck:Leak
   ...
   fun:_dl_init
}

{
   qt_test_thread_tls
   Memcheck:Leak
   match-leak-kinds: possible
   fun:calloc
   fun:calloc
   fun:allocate_dtv
   fun:_dl_allocate_tls
   fun:allocate_stack
   fun:pthread_create@@GLIBC_2.34
   fun:_ZN7QThread5startENS_8PriorityE
}

{
   libproxy_factory_new
   Memcheck:Leak
   ...
   fun:px_proxy_factory_new
}

{
   libproxy_manager_new
   Memcheck:Leak
   ...
   fun:px_manager_new_with_options
}

{
   libproxy_backend
   Memcheck:Leak
   ...
   obj:*/libpxbackend*
}

{
   libgio_extension_point
   Memcheck:Leak
   ...
   fun:g_io_extension_point_implement
}

{
   libgio_vfs_default
   Memcheck:Leak
   ...
   fun:g_vfs_get_default
}

{
   libglib_charset
   Memcheck:Leak
   ...
   fun:g_get_charset
}

{
   libglib_filename_charsets
   Memcheck:Leak
   ...
   fun:g_get_filename_charsets
}

{
   libduktape_realloc_zero
   Memcheck:Leak
   ...
   obj:*/libduktape*
}

{
   libgio_dbus_init
   Memcheck:Leak
   ...
   fun:g_dbus_connection_new_for_address_sync
}

{
   libgio_network_monitor
   Memcheck:Leak
   ...
   fun:g_network_monitor_base_get_type
}

{
   libgobject_type_register
   Memcheck:Leak
   ...
   fun:g_type_register_static
}

{
   qt_textblock_text_invalid_read
   Memcheck:Addr16
   ...
   fun:*QTextBlock*text*
}

{
   qt_textblock_text_uninit_cond
   Memcheck:Cond
   ...
   fun:*QTextBlock*text*
}

{
   qt_textdocument_contents_change_cond
   Memcheck:Cond
   ...
   fun:*QTextDocument*contentsChange*
}

{
   qt_syntaxhighlighter_cond
   Memcheck:Cond
   ...
   fun:*QSyntaxHighlighter*
}

# ---- Qt WebEngine / Chromium internal false positives ----
# Chromium's multi-threaded architecture (Chrome_IOThread, ThreadPoolService,
# renderer processes) produces many Valgrind false positives: invalid reads
# from SIMD-optimized string ops, conditional jumps on padding bytes, and
# global singletons that intentionally outlive the process (fontconfig,
# udev, ProfileAdapter). None of these are scowser code.

{
   webengine_cond
   Memcheck:Cond
   ...
   obj:*/libQt6WebEngineCore.so*
}

{
   webengine_addr1
   Memcheck:Addr1
   ...
   obj:*/libQt6WebEngineCore.so*
}

{
   webengine_addr2
   Memcheck:Addr2
   ...
   obj:*/libQt6WebEngineCore.so*
}

{
   webengine_addr4
   Memcheck:Addr4
   ...
   obj:*/libQt6WebEngineCore.so*
}

{
   webengine_addr8
   Memcheck:Addr8
   ...
   obj:*/libQt6WebEngineCore.so*
}

{
   webengine_addr16
   Memcheck:Addr16
   ...
   obj:*/libQt6WebEngineCore.so*
}

{
   webengine_value4
   Memcheck:Value4
   ...
   obj:*/libQt6WebEngineCore.so*
}

{
   webengine_value8
   Memcheck:Value8
   ...
   obj:*/libQt6WebEngineCore.so*
}

{
   webengine_leak
   Memcheck:Leak
   ...
   obj:*/libQt6WebEngineCore.so*
}

# fontconfig init triggered by Chromium
{
   fontconfig_leak
   Memcheck:Leak
   ...
   obj:*/libfontconfig.so*
}

{
   fontconfig_cond
   Memcheck:Cond
   ...
   obj:*/libfontconfig.so*
}

# expat (used by fontconfig)
{
   expat_leak
   Memcheck:Leak
   ...
   obj:*/libexpat.so*
}

# udev device monitoring started by Chromium
{
   udev_leak
   Memcheck:Leak
   ...
   obj:*/libudev.so*
}
